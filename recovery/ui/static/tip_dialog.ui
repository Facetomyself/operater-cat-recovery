}


QLabel{
color: #ebf905;
}



QRadioButton,QCheckBox {
        border: none;
        border-radius: 7px;
}
QRadioButton::indicator,QCheckBox::indicator{
    background-color: rgb(42, 45, 66);
    border: 0px solid #b1b1b1;
	width: 14px;
	height: 14px;
	border-radius: 7px;
}

QRadioButton::indicator:checked,QCheckBox::indicator:checked {
    background-color: #ebf905;
    border-color: #ebf905;
}
