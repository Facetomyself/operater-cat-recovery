  <property name="styleSheet">
   <string notr="true">*{
background-color:#3c3f42;
color: #e6e6e6;
}

*:disabled {
	background-color: #3c3f42;
	color: #afafaf;
	cursor: not-allowed;

}
QListWidget:disabled,QTextEdit:disabled,QLineEdit:disabled,QTabWidget:disabled{
background-color:rgb(40, 40, 40);
}
QTextBrowser:disabled{
background-color:rgb(40, 40, 40);
color: rgb(152, 197, 150);
}

QPushButton:disabled {
	background-color: rgb(80, 80, 80);
	color: #afafaf;
	cursor: not-allowed;

}

QCheckBox:hover,QRadioButton:hover {
color: white;
}

QPushButton:hover {

font-weight: bold;
background-color:rgb(84, 84, 84);
color: white;
border-radius: 2pt;

}

QPushButton{
font-weight: bold;
background-color:rgb(106, 106, 106);
color: #e6e6e6;
border-radius: 2pt;
}

QTextBrowser,QListWidget,QTextEdit,QTabWidget{
background-color:rgb(40, 40, 40);
color: rgba(152, 197, 150, 185);
font-size:10pt;
}

QTextBrowser:hover,QTextEdit:hover{
background-color:rgb(40, 40, 40);
color: rgb(152, 197, 150);
font-size:10pt;
}

QLineEdit{
background-color:rgb(40, 40, 40);
color: rgba(152, 197, 150, 185);
font-size:12pt;
}

QLineEdit:hover{
background-color:rgb(40, 40, 40);
color: rgb(152, 197, 150);
font-size:12pt;
}


QLabel{
color: #ebf905;
}



QRadioButton,QCheckBox {
        border: none;
        border-radius: 9px;
}
QRadioButton::indicator,QCheckBox::indicator{
    background-color: rgb(42, 45, 66);
    border: 0px solid #b1b1b1;
	width: 18px;
	height: 18px;
	border-radius: 9px;
}

QRadioButton::indicator:checked,QCheckBox::indicator:checked {
    background-color: #ebf905;
    border-color: #ebf905;
}

QMenuBar { background-color: transparent; }
QMenuBar::item { background-color: transparent; }
QMenuBar::item:selected { background-color:transparent; color: #ffffff;}
QMenu { background-color: transparent; }
QMenu::item { background-color: transparent; }
QMenu::item:selected { background-color: transparent; color: #ffffff; }
QToolTip {
                background-color: #3c3f42;
                color: #e0e0e0;
                border: 1px solid #666;
                border-radius: 4px;
                padding: 6px;
                font-size: 13px;
