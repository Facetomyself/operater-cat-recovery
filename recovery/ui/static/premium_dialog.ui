   <string notr="true">*{
background-color:#3c3f42;
color: #e6e6e6;
}

*:disabled {
	background-color: #3c3f42;
	color: #afafaf;
	cursor: not-allowed;

}
QListWidget:disabled,QTextEdit:disabled,QLineEdit:disabled,QTabWidget:disabled{
background-color:rgb(40, 40, 40);
}
QTextBrowser:disabled{
background-color:rgb(40, 40, 40);
color: rgb(152, 197, 150);
}

QPushButton:disabled {
	background-color: rgb(80, 80, 80);
	color: #afafaf;
	cursor: not-allowed;

}

QCheckBox:hover,QRadioButton:hover {
color: white;
}

QPushButton:hover {

font-weight: bold;
background-color:rgb(84, 84, 84);
color: white;
border-radius: 2pt;

}

QPushButton{
font-weight: bold;
background-color:rgb(106, 106, 106);
color: #e6e6e6;
border-radius: 2pt;
}

QTextBrowser,QListWidget,QTextEdit,QTabWidget{
background-color:rgb(40, 40, 40);
color: rgba(152, 197, 150, 185);
font-size:10pt;
}

QTextBrowser:hover,QTextEdit:hover{
